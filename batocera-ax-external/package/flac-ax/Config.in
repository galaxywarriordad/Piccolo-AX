config BR2_PACKAGE_FLAC_AX
	bool "FLAC_AX & [AX] Audio/Visual Appliance Suite"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_AX_SDK
	select BR2_PACKAGE_FLAC
	select BR2_PACKAGE_ALSA_LIB
	help
	  Deterministic [AX] bit-perfect S32_LE & DoP (DSD64/DSD128) audio
	  transport (flac_ax) with multi-DAC USB isolation rules.

if BR2_PACKAGE_FLAC_AX

config BR2_PACKAGE_FLAC_AX_AV_STUDIO
	bool "Build ax_av_studio (MPK Mini MK3 + Synth + OpenGL HUD)"
	default y
	select BR2_PACKAGE_SDL2
	help
	  2.00 ms 16-voice polyphonic subtractive + 8-voice drum synthesizer,
	  Schroeder reverb, tape delay, and VBlank-locked OpenGL HUD.

config BR2_PACKAGE_FLAC_AX_VIDEO_UPSCALER
	bool "Build ax_video_upscaler (720p/1080p/2K V4L2 & DVD upscaler)"
	default y
	help
	  Single-stream 720p/1080p/2K retro HDMI capture (MS2130S) and DVD
	  upscaler synchronized to the DAC master sample clock.

config BR2_PACKAGE_FLAC_AX_APPLIANCE_TUI
	bool "Build ax_appliance_tui (Core 5 Espresso Appliance Launcher)"
	default y
	help
	  Zero-dependency 24-bit ANSI Coffee/Espresso TUI launcher pinned
	  to Core 5 (0x20) with live DAC lock and RAM telemetry.

config BR2_PACKAGE_FLAC_AX_USB_DAC_RULES
	bool "Install 99-ax-usb-dacs.rules (HiBy FC3, KA11, Black Pearl, Dawn Pro 2, Apple)"
	default y
	help
	  Installs udev rules bypassing PulseAudio/PipeWire ACP claiming and
	  disabling USB autosuspend for supported UAC 2.0 USB-C DACs.

endif
