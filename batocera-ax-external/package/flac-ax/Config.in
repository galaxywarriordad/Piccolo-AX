config BR2_PACKAGE_FLAC_AX
	bool "flac-ax"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_AX_SDK
	select BR2_PACKAGE_FLAC
	select BR2_PACKAGE_ALSA_LIB
	help
	  Deterministic [AX] bit-perfect audio transport (flac_ax),
	  live synthesizer studio (ax_av_studio), and 720p/1080p/2K
	  retro/DVD upscaler (ax_video_upscaler).
