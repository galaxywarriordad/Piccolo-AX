config BR2_PACKAGE_AMIBERRY_AX
	bool "Amiberry [AX] (Commodore Amiga 500 / 1200 / CD32)"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_AX_SDK
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_SDL2_IMAGE
	select BR2_PACKAGE_SDL2_TTF
	select BR2_PACKAGE_FLAC
	select BR2_PACKAGE_LIBMPG123
	select BR2_PACKAGE_LIBPNG
	select BR2_PACKAGE_LIBXML2
	select BR2_PACKAGE_ZLIB
	help
	  Deterministic Commodore Amiga (OCS/ECS/AGA, A500/A1200/CD32) engine
	  compiled with standalone Clang 23.1+ (ThinLTO) and linked against ax-sdk.
