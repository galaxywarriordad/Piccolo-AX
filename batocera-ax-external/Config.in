menu "Piccolo [AX] Console Appliance"

config BR2_PACKAGE_AX_SDK
	bool "ax-sdk (libax_core)"
	default y
	help
	  Shared dependency-free C++20 deterministic hardware runtime
	  for The Silicon Preservation Society emulators.

config BR2_PACKAGE_EDEN_AX
	bool "Eden Espresso Wave [AX] (Nintendo Switch)"
	default y
	select BR2_PACKAGE_AX_SDK
	help
	  Deterministic Nintendo Switch emulator compiled with standalone
	  Clang 23.1+ (ThinLTO + 3-Phase PGO) and linked against ax-sdk.

config BR2_PACKAGE_CEMU_LATTE_AX
	bool "Cemu Latte [AX] (Nintendo Wii U)"
	default y
	select BR2_PACKAGE_AX_SDK
	help
	  Deterministic Nintendo Wii U emulator compiled with standalone
	  Clang 23.1+ (ThinLTO + 3-Phase PGO) and linked against ax-sdk.

config BR2_PACKAGE_RMG_AX
	bool "RMG-Mupen [AX] (Nintendo 64)"
	default y
	select BR2_PACKAGE_AX_SDK
	select BR2_PACKAGE_QT6
	select BR2_PACKAGE_QT6BASE
	select BR2_PACKAGE_QT6BASE_GUI
	select BR2_PACKAGE_QT6BASE_WIDGETS
	select BR2_PACKAGE_QT6BASE_OPENGL
	select BR2_PACKAGE_QT6BASE_VULKAN
	select BR2_PACKAGE_QT6SVG
	select BR2_PACKAGE_QT6WEBSOCKETS
	select BR2_PACKAGE_SDL3
	select BR2_PACKAGE_LIBSAMPLERATE
	select BR2_PACKAGE_SPEEXDSP
	select BR2_PACKAGE_LIBUSB
	select BR2_PACKAGE_HIDAPI
	select BR2_PACKAGE_MINIZIP
	select BR2_PACKAGE_FREETYPE
	select BR2_PACKAGE_VULKAN_HEADERS
	help
	  Deterministic Nintendo 64 emulator (Rosalie's Mupen GUI) linked against ax-sdk.

config BR2_PACKAGE_CANNONBALL_AX
	bool "Cannonball-OutRun [AX] (Sega Arcade)"
	default y
	select BR2_PACKAGE_AX_SDK
	select BR2_PACKAGE_BOOST
	select BR2_PACKAGE_SDL2
	help
	  Deterministic Sega OutRun C++ arcade engine linked against ax-sdk.

config BR2_PACKAGE_FRONTIER_AX
	bool "Frontier: Elite II [AX] (Atari ST 68k-to-C)"
	default y
	select BR2_PACKAGE_AX_SDK
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_LIBGLU
	help
	  Deterministic 1993 Atari ST Frontier: Elite II engine linked against ax-sdk.

config BR2_PACKAGE_BLASTEM_AX
	bool "BlastEm-MegaDrive [AX] (Sega Mega Drive / YM2612)"
	default y
	select BR2_PACKAGE_AX_SDK
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_LIBGLEW
	help
	  Cycle-accurate Sega Mega Drive / Genesis engine (YM2612 FM + 68k/Z80 JIT) linked against ax-sdk.

config BR2_PACKAGE_LSFG_VK

	bool "lsfg-vk 2.0.0+ (Implicit Vulkan Frame Generation)"
	default y
	help
	  Vulkan 1.2 bindless FP32 frame-generation layer (requires user-supplied
	  Lossless.dll placed in /userdata/system/lsfg/Lossless.dll).

config BR2_PACKAGE_VMTOUCH
	bool "vmtouch (MAP_POPULATE RAM Asset Pinner)"
	default y
	help
	  Bulk pre-faults filtered game containers into DDR4 RAM (-dql).

endmenu
```[cite: 8]

*Verification:* After pasting and committing `frontier-ax.mk`, run a Buildroot dry-run or package build (`make frontier-ax-source` / `make frontier-ax`) and confirm `as68k/as68k` runs on the host and `$(TARGET_DIR)/usr/bin/frontier-fe2` is created.

