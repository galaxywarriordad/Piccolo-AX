#!/bin/sh
### BEGIN INIT INFO
# Provides:          K01piccolo-sync
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 6
# Short-Description: Atomic /dev/shm to /userdata save & state sync for Piccolo-AX
### END INIT INFO

set -eu

SHM_ROOT="/dev/shm/piccolo-ax"
PERSIST_ROOT="/userdata"
SNES_SHM_SAVES="${SHM_ROOT}/snes/saves"
SNES_PERSIST_SAVES="${PERSIST_ROOT}/saves/snes"
SNES_SHM_ROMS="${SHM_ROOT}/snes/roms"

sync_dir_atomic() {
    src_dir="$1"
    dst_dir="$2"

    [ -d "$src_dir" ] || return 0
    mkdir -p "$dst_dir"

    for f in "$src_dir"/*; do
        [ -f "$f" ] || continue
        base="$(basename "$f")"
        dst_file="${dst_dir}/${base}"
        tmp_file="${dst_file}.tmp.$$"

        cp -f "$f" "$tmp_file"
        sync
        mv -f "$tmp_file" "$dst_file"
    done
    sync
}

stage_snes_saves() {
    mkdir -p "$SNES_SHM_SAVES" "$SNES_SHM_ROMS" "$SNES_PERSIST_SAVES"
    for f in "$SNES_PERSIST_SAVES"/*.srm; do
        [ -f "$f" ] || continue
        base="$(basename "$f")"
        cp -f "$f" "${SNES_SHM_SAVES}/${base}"
    done
}

flush_all() {
    sync_dir_atomic "$SNES_SHM_SAVES" "$SNES_PERSIST_SAVES"
}

case "${1:-save}" in
    start|stage)
        stage_snes_saves
        ;;
    save|stop|flush)
        flush_all
        ;;
    status)
        echo "SHM saves: $(ls -1 "$SNES_SHM_SAVES" 2>/dev/null | wc -l) files"
        echo "Persistent saves: $(ls -1 "$SNES_PERSIST_SAVES" 2>/dev/null | wc -l) files"
        ;;
    *)
        echo "Usage: $0 {start|stage|save|stop|flush|status}" >&2
        exit 2
        ;;
esac

exit 0
