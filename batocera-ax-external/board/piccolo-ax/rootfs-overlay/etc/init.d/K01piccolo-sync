#!/bin/sh
# Piccolo-AX Crash-Safe Ephemeral Cache Sync (/dev/shm <-> /userdata/system/ax-sync)

SYNC_DIR="/userdata/system/ax-sync"
SHARE_MOUNT="/userdata"
CACHES="emu_cache pgo nv_cache"
MIN_RESERVE_KB=65536

is_share_writable() {
    [ -d "${SHARE_MOUNT}" ] && [ -w "${SHARE_MOUNT}" ]
}

cleanup_stale_tmp() {
    [ -d "${SYNC_DIR}" ] || return 0
    for f in "${SYNC_DIR}"/*.tar.zst.tmp*; do
        [ -e "$f" ] && rm -f "$f" 2>/dev/null || true
    done
}

restore_cache() {
    name="$1"
    shm_dir="/dev/shm/${name}"
    primary="${SYNC_DIR}/${name}.tar.zst"
    backup="${SYNC_DIR}/${name}.tar.zst.prev"

    mkdir -p "${shm_dir}"
    is_share_writable || return 0

    chosen=""
    if [ -s "${primary}" ] && zstd -t -q "${primary}" 2>/dev/null; then
        chosen="${primary}"
    elif [ -s "${backup}" ] && zstd -t -q "${backup}" 2>/dev/null; then
        echo "[K01piccolo-sync] Primary ${name}.tar.zst corrupt/missing; falling back to .prev"
        chosen="${backup}"
    fi

    if [ -n "${chosen}" ]; then
        zstd -dc "${chosen}" | tar -xf - -C "/dev/shm" 2>/dev/null || true
    fi
}

save_cache() {
    name="$1"
    shm_dir="/dev/shm/${name}"
    target="${SYNC_DIR}/${name}.tar.zst"
    backup="${SYNC_DIR}/${name}.tar.zst.prev"
    tmp="${SYNC_DIR}/${name}.tar.zst.tmp.$$"

    [ -d "${shm_dir}" ] || return 0
    [ -n "$(ls -A "${shm_dir}" 2>/dev/null)" ] || return 0
    is_share_writable || return 0

    mkdir -p "${SYNC_DIR}"

    src_kb=$(du -sk "${shm_dir}" 2>/dev/null | awk '{print $1}')
    avail_kb=$(df -kP "${SYNC_DIR}" 2>/dev/null | awk 'NR==2 {print $4}')
    [ -n "${src_kb}" ] && [ -n "${avail_kb}" ] || return 0

    # Require 1.25x source size + 64 MiB safety margin
    req_kb=$(( (src_kb * 5 / 4) + MIN_RESERVE_KB ))
    if [ "${avail_kb}" -lt "${req_kb}" ]; then
        echo "[K01piccolo-sync] Skipping ${name} sync: ${avail_kb} KiB free < ${req_kb} KiB required"
        return 0
    fi

    if tar -cf - -C "/dev/shm" "${name}" 2>/dev/null | zstd -3 -T1 -q -o "${tmp}"; then
        if zstd -t -q "${tmp}" 2>/dev/null; then
            if [ -f "${target}" ] && zstd -t -q "${target}" 2>/dev/null; then
                cp -f "${target}" "${backup}" 2>/dev/null || true
            fi
            mv -f "${tmp}" "${target}"
            sync
        else
            rm -f "${tmp}"
        fi
    else
        rm -f "${tmp}"
    fi
}

case "$1" in
    start)
        cleanup_stale_tmp
        for c in ${CACHES}; do
            restore_cache "${c}"
        done
        ;;
    sync|checkpoint|stop)
        cleanup_stale_tmp
        for c in ${CACHES}; do
            save_cache "${c}"
        done
        ;;
    *)
        echo "Usage: $0 {start|sync|checkpoint|stop}"
        exit 1
        ;;
esac
exit 0
