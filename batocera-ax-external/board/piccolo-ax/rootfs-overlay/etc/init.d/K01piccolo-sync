#!/bin/sh
# Piccolo-AX Crash-Safe Ephemeral Cache Sync (/dev/shm <-> /userdata/system/ax-sync)

SYNC_DIR="/userdata/system/ax-sync"
CACHES="emu_cache pgo nv_cache"
MIN_RESERVE_KB=65536

cleanup_stale_tmp() {
    [ -d "${SYNC_DIR}" ] || return 0
    rm -f "${SYNC_DIR}"/*.tmp.* 2>/dev/null || true
}

restore_cache() {
    name="$1"
    shm_dir="/dev/shm/${name}"
    primary="${SYNC_DIR}/${name}.tar.zst"
    backup="${SYNC_DIR}/${name}.tar.zst.prev"

    mkdir -p "${shm_dir}"

    chosen=""
    if [ -s "${primary}" ] && zstd -t -q "${primary}" 2>/dev/null; then
        chosen="${primary}"
    elif [ -s "${backup}" ] && zstd -t -q "${backup}" 2>/dev/null; then
        echo "[K01piccolo-sync] Primary ${name}.tar.zst corrupt/missing; falling back to .prev"
        chosen="${backup}"
    fi

    if [ -n "${chosen}" ]; then
        zstd -dc "${chosen}" | tar -xf - -C "/dev/shm" 2>/dev/null || true
    fi
}

save_cache() {
    name="$1"
    shm_dir="/dev/shm/${name}"
    target="${SYNC_DIR}/${name}.tar.zst"
    backup="${SYNC_DIR}/${name}.tar.zst.prev"
    tmp="${SYNC_DIR}/${name}.tar.zst.tmp.$$"

    [ -d "${shm_dir}" ] || return 0
    # Skip if directory is completely empty
    [ -n "$(ls -A "${shm_dir}" 2>/dev/null)" ] || return 0

    mkdir -p "${SYNC_DIR}"

    src_kb=$(du -sk "${shm_dir}" | awk '{print $1}')
    avail_kb=$(df -kP "${SYNC_DIR}" | awk 'NR==2 {print $4}')
    # Require 1.25x source size + 64 MiB safety margin
    req_kb=$(( (src_kb * 5 / 4) + MIN_RESERVE_KB ))

    if [ "${avail_kb:-0}" -lt "${req_kb}" ]; then
        echo "[K01piccolo-sync] Skipping ${name} sync: ${avail_kb} KiB free < ${req_kb} KiB required"
        return 0
    fi

    if tar -cf - -C "/dev/shm" "${name}" | zstd -3 -T1 -q -o "${tmp}"; then
        if zstd -t -q "${tmp}" 2>/dev/null; then
            sync "${tmp}" 2>/dev/null || sync
            [ -f "${target}" ] && cp -f "${target}" "${backup}" 2>/dev/null || true
            mv -f "${tmp}" "${target}"
            sync "${SYNC_DIR}" 2>/dev/null || sync
        else
            rm -f "${tmp}"
        fi
    else
        rm -f "${tmp}"
    fi
}

case "$1" in
    start)
        cleanup_stale_tmp
        for c in ${CACHES}; do
            restore_cache "${c}"
        done
        ;;
    sync|checkpoint)
        cleanup_stale_tmp
        for c in ${CACHES}; do
            save_cache "${c}"
        done
        ;;
    stop)
        for c in ${CACHES}; do
            save_cache "${c}"
        done
        ;;
    *)
        echo "Usage: $0 {start|sync|checkpoint|stop}"
        exit 1
        ;;
esac
exit 0
