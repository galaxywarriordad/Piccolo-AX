#!/bin/sh
# ax-mode-cli — Dispatch Piccolo-AX boot mode (retro | audio | encode2go | desktop)
set -eu

MODE="${1:-}"
if [ -z "$MODE" ] && [ -r /proc/cmdline ]; then
	MODE="$(sed -n 's/.*ax\.mode=\([a-zA-Z0-9_-]*\).*/\1/p' /proc/cmdline 2>/dev/null | head -n 1 || true)"
fi
[ -n "$MODE" ] || MODE="retro"

case "$MODE" in
	retro)
		exec /usr/bin/ax_appliance_tui
		;;
	audio)
		exec /usr/bin/flac_ax
		;;
	encode2go)
		if [ "$#" -gt 1 ]; then
			shift
			exec taskset -c 5 /usr/bin/ax-encode-2go "$@"
		fi
		if command -v ax_appliance_tui >/dev/null 2>&1; then
			exec taskset -c 5 /usr/bin/ax_appliance_tui --encode /userdata/videos/sample.mp4
		fi
		exec taskset -c 5 /usr/bin/ax-encode-2go /userdata/videos/sample.mp4
		;;
	desktop)
		exec startx
		;;
	*)
		echo "[ax-mode-cli] Unknown mode '$MODE'; defaulting to 'retro'" >&2
		exec /usr/bin/ax_appliance_tui
		;;
esac
