# --- Shared Pruned Qt6 Runtime for AX Emulators (Eden, RMG, Cemu) ---
BR2_PACKAGE_QT6=y
BR2_PACKAGE_QT6BASE=y
BR2_PACKAGE_QT6BASE_GUI=y
BR2_PACKAGE_QT6BASE_WIDGETS=y
BR2_PACKAGE_QT6BASE_OPENGL=y
BR2_PACKAGE_QT6BASE_VULKAN=y
BR2_PACKAGE_QT6BASE_XCB=y          # Enable if Piccolo-AX uses Xorg/X11
# BR2_PACKAGE_QT6WAYLAND=y         # Enable instead if Piccolo-AX uses Wayland/Cage
BR2_PACKAGE_QT6BASE_DBUS=y
BR2_PACKAGE_QT6BASE_NETWORK=y
BR2_PACKAGE_QT6BASE_CONCURRENT=y
BR2_PACKAGE_QT6SVG=y
BR2_PACKAGE_QT6WEBSOCKETS=y        # Needed for RMG netplay / RPC

# --- Strip Bloat to Stay Under 300 MB ---
# BR2_PACKAGE_QT6BASE_EXAMPLES is not set
# BR2_PACKAGE_QT6BASE_TESTS is not set
# BR2_PACKAGE_QT6WEBENGINE is not set
# BR2_PACKAGE_QT6MULTIMEDIA is not set
# BR2_PACKAGE_QT6DECLARATIVE is not set
