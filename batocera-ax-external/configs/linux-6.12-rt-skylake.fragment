# Real-Time Preemption & Tickless Core Isolation (Cores 0-4)
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
CONFIG_NO_HZ_FULL=y
CONFIG_NO_HZ_FULL_NODEF=y
CONFIG_RCU_NOCB_CPU=y
CONFIG_RCU_NOCB_CPU_DEFAULT_ALL=y
CONFIG_RCU_LAZY=n
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HZ_1000=y

# Pure cgroup v2 Hierarchy (Required for cpuset.cpus.partition=isolated)
CONFIG_CGROUPS=y
CONFIG_CPUSETS=y
CONFIG_CPUSETS_V1=n

# Hybrid 1G / 2M HugeTLB & Zero-Disk ZRAM Valve
CONFIG_HUGETLBFS=y
CONFIG_HUGETLB_PAGE=y
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_CRYPTO_LZ4=y

# Immutable RAM-Resident EROFS Boot
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y

# Built-In Storage, Dual-xHCI, USB Audio & GPU Plumbing (=y)
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_SND_USB_AUDIO=y
CONFIG_DRM_I915=y
CONFIG_DRM_TTM_HELPER=y
CONFIG_MSR=y
