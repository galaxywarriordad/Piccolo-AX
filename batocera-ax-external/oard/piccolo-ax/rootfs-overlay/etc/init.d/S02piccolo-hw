#!/bin/sh
# S02piccolo-hw — 1:1 MSI IRQ binding, USB DAC low-latency & async SwitchHDD mount

case "$1" in
  start)
    echo "[Piccolo-AX] Binding hardware IRQs & low-latency USB DAC parameters..."
    mkdir -p /etc/modprobe.d
    cat << 'EOF' > /etc/modprobe.d/piccolo-audio.conf
options snd-usb-audio nrpacks=1 lowlatency=1
EOF

    # Bind GTX 980 Ti MSI IRQ to Core 1 (0x02)
    for irq in $(grep -i "nvidia" /proc/interrupts | awk -F: '{print $1}' | tr -d ' '); do
        echo 02 > "/proc/irq/${irq}/smp_affinity" 2>/dev/null || true
    done

    # Bind HiBy FC3 xHCI controller MSI IRQ to Core 0 (0x01)
    FC3_BUS=$(lsusb | grep -iE "2fc6|HiBy" | awk '{print $2}' | sed 's/^0*//')
    if [ -n "$FC3_BUS" ]; then
        XHCI_PCI=$(basename "$(readlink -f "/sys/bus/usb/devices/usb${FC3_BUS}/../")" 2>/dev/null || true)
        for irq in $(grep "${XHCI_PCI}" /proc/interrupts | awk -F: '{print $1}' | tr -d ' '); do
            echo 01 > "/proc/irq/${irq}/smp_affinity" 2>/dev/null || true
        done
    fi

    # Enable NVIDIA persistence mode (580.* legacy branch)
    nvidia-smi -pm 1 >/dev/null 2>&1 || true

    # Stage RAM tmpfs shader directories
    mkdir -p /dev/shm/eden_cache /dev/shm/nv_cache

    # Mount SwitchHDD asynchronously on Core 5 so spin-up never blocks boot
    mkdir -p /userdata/roms
    taskset -c 5 sh -c 'mount -L SwitchHDD -o ro,noatime /userdata/roms 2>/dev/null || true' &
    ;;
  stop)
    ;;
esac
exit 0
