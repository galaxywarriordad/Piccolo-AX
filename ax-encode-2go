#!/bin/sh
# ax-encode-2go — Piccolo-AX (i5-9600K QSV + GTX 980 Ti) 640x480 G350 Movie Encoder
set -eu

TARGET_FPS="60"

usage() {
	echo "Usage: ax-encode-2go [--60fps|--30fps] <input_video> [output_video]" >&2
	exit 1
}

while [ "$#" -gt 0 ]; do
	case "$1" in
		--60fps) TARGET_FPS="60"; shift ;;
		--30fps) TARGET_FPS="30"; shift ;;
		-h|--help) usage ;;
		--) shift; break ;;
		-*) echo "Unknown option: $1" >&2; usage ;;
		*) break ;;
	esac
done

[ "$#" -ge 1 ] || usage

INPUT="$1"
[ -f "$INPUT" ] || {
	echo "Error: input file not found: $INPUT" >&2
	exit 1
}

if [ "$#" -ge 2 ] && [ -n "$2" ]; then
	OUTPUT="$2"
else
	BASE="${INPUT%.*}"
	OUTPUT="${BASE}_g350_640x480_${TARGET_FPS}fps.mp4"
fi

mkdir -p "$(dirname "$OUTPUT")"

# RK3326 / G350-safe H.264 parameters:
# - Main profile + zero B-frames (-bf 0) for low-latency Cortex-A35 software decode at 60 fps
# - GOP = TARGET_FPS (1-second keyframes) + VBV cap (3.5 Mbps) to prevent SD/bus spikes
GOP_SIZE="$TARGET_FPS"

# Core 5 (0x20) housekeeping/I/O plane:
# - Intel QSV (i5-9600K iGPU) handles hardware decode/encode (h264_qsv)
# - NVIDIA GTX 980 Ti (cuda) runs Lanczos scaling + semi-pro image optimization
# - Audio outputs 48000 Hz stereo AAC for zero-resampling playback on Piccolo-2go (G350)
run_qsv_plus_nvidia() {
	taskset -c 5 ffmpeg -y \
		-init_hw_device qsv=qsv:/dev/dri/renderD128 \
		-init_hw_device cuda=nv:0 \
		-filter_hw_device qsv \
		-hwaccel qsv \
		-hwaccel_output_format qsv \
		-i "$INPUT" \
		-vf "hwdownload,format=nv12,hwupload_cuda,scale_cuda=640:480:force_original_aspect_ratio=decrease:interp_algo=lanczos,hwdownload,format=nv12,hqdn3d=1.5:1.2:2.0:1.5,eq=contrast=1.04:brightness=0.01:gamma=0.98:saturation=1.05,unsharp=3:3:0.35:3:3:0.0,pad=640:480:(ow-iw)/2:(oh-ih)/2:black,fps=${TARGET_FPS},format=nv12,hwupload=extra_hw_frames=64" \
		-c:v h264_qsv -profile:v main -preset veryslow -global_quality 21 -bf 0 -g "$GOP_SIZE" -maxrate 3500k -bufsize 7000k \
		-c:a aac -ar 48000 -ac 2 -b:a 160k \
		-movflags +faststart \
		"$OUTPUT"
}

run_qsv_only() {
	taskset -c 5 ffmpeg -y \
		-init_hw_device qsv=qsv:/dev/dri/renderD128 \
		-filter_hw_device qsv \
		-hwaccel qsv \
		-hwaccel_output_format qsv \
		-i "$INPUT" \
		-vf "vpp_qsv=w=640:h=480:scale_mode=2:denoise=15:detail=25,fps=${TARGET_FPS},format=nv12" \
		-c:v h264_qsv -profile:v main -preset veryslow -global_quality 21 -bf 0 -g "$GOP_SIZE" -maxrate 3500k -bufsize 7000k \
		-c:a aac -ar 48000 -ac 2 -b:a 160k \
		-movflags +faststart \
		"$OUTPUT"
}

if ! run_qsv_plus_nvidia; then
	echo "[ax-encode-2go] CUDA bridge unavailable or failed; falling back to QSV-only pipeline on Core 5..." >&2
	run_qsv_only
fi

echo "[ax-encode-2go] Encoded for G350 (640x480 @ ${TARGET_FPS}fps, Main/no-B-frames, 48kHz AAC): $OUTPUT"
